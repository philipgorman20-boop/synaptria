{
  "name": "synaptria",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @synaptria/database db:generate",
    "db:migrate": "pnpm --filter @synaptria/database db:migrate",
    "db:studio": "pnpm --filter @synaptria/database db:studio",
    "db:seed:mission-control": "pnpm --filter @synaptria/database db:seed:mission-control"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma", "sharp", "unrs-resolver"]
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  }
}