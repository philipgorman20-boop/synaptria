{
  "name": "@synaptria/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts prisma/mission-control-demo/**/*.test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:mission-control": "tsx prisma/seed-mission-control-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@synaptria/audit": "workspace:*",
    "@synaptria/core": "workspace:*",
    "@synaptria/events": "workspace:*",
    "@synaptria/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "prisma": "^6.12.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
