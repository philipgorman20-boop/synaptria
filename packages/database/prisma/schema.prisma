  SERIES_A
  SERIES_B
  SERIES_C
  SERIES_D_PLUS
  BRIDGE
  SAFE
  CONVERTIBLE_NOTE
  DEBT
  OTHER
}

enum FundingRoundStatus {
  PLANNED
  OPEN
  CLOSED
  CANCELLED
}

enum GrantStatus {
  IDENTIFIED
  APPLYING
  SUBMITTED
  AWARDED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum RevenueType {
