  MILESTONE
  ROYALTY
  COLLABORATION
  SERVICE
  GRANT_REIMBURSEMENT
  OTHER
}

enum BudgetStatus {
  DRAFT
  APPROVED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum BudgetPeriodType {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum ExpenseStatus {
  PLANNED
  SUBMITTED
  APPROVED
  PAID
  VOIDED
}

enum CommitmentStatus {
  PROPOSED
  APPROVED
  ACTIVE
  FULFILLED
  CANCELLED
}

enum ForecastStatus {
