  QUALIFYING
  APPROVED
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED
}

enum VendorCategory {
  CRO
  CDMO
  CONSULTANT
  LEGAL
  REGULATORY
  CLINICAL
  SOFTWARE
  EQUIPMENT
  LAB_SUPPLIES
