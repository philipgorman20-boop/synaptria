// Synaptria production domain schema v3
// Generated as a clean target architecture. Validate before creating migrations.
// Tenant-owned records carry organizationId to support application-level isolation
// and future PostgreSQL row-level-security policies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecordStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProgramStatus {
  CONCEPT
  DISCOVERY
  PRECLINICAL
  IND_ENABLING
  CLINICAL
  PARTNERED
  ON_HOLD
  COMPLETED
  TERMINATED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  BLOCKED
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum RiskStatus {
  OPEN
  MITIGATING
  ACCEPTED
  CLOSED
}

enum RiskCategory {
  SCIENTIFIC
  CLINICAL
  REGULATORY
  CMC
  MANUFACTURING
  FINANCIAL
  VENDOR
  OPERATIONAL
  LEGAL
  IP
  PEOPLE
  OTHER
}

